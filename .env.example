# Adres backendu CRM
NEXT_PUBLIC_API_URL=https://investrent-crm-production.up.railway.app

# Opcjonalnie: Google Maps API key do mapy na stronie kontaktu
NEXT_PUBLIC_MAPS_KEY=

# Opcjonalnie: Google Analytics ID
NEXT_PUBLIC_GA_ID=

# Flagi kalkulatora (domyslnie WYLACZONE; wlaczenie = on + redeploy)
# Blok telefonu pod wynikiem
NEXT_PUBLIC_WYCENA_PHONE_BLOCK=
# Wysylka numeru przez POST /api/public/valuation/callback (CRM: valuation_token z /estimate)
NEXT_PUBLIC_WYCENA_CALLBACK=
# Licznik lejka POST /api/public/valuation/funnel-step (po migracji CRM #1066)
NEXT_PUBLIC_WYCENA_FUNNEL=
NEXT_PUBLIC_WYCENA_MARKET_CARD=
